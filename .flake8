[flake8]
max-line-length = 100
# E203 (whitespace before ':') and W503 (line break before binary operator)
# conflict with Black's formatting; the Black docs recommend ignoring them.
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    build,
    dist,
    *.egg-info
